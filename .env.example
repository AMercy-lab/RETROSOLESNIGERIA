# =====================================================================
# RSN environment variables — TEMPLATE (safe to commit: no real values)
#
# 1. Copy this file and name the copy  .env.local
# 2. Fill in the real values in .env.local
# 3. Restart `npm run dev`
#
# .env.local is ignored by Git, so your secrets never reach GitHub.
# Variables starting with NEXT_PUBLIC_ are sent to the browser — never put
# a secret in a NEXT_PUBLIC_ variable.
# =====================================================================

# --- Supabase (dashboard → Project Settings → Data API / API Keys) ---
# Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (starts with sb_publishable_...). Safe in the browser:
# it can only do what the database security rules allow.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (starts with sb_secret_...). SERVER ONLY — bypasses security rules.
# Never share it, never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Added in later stages (leave commented out for now) ---
# PAYSTACK_SECRET_KEY=
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=
# ADMIN_NOTIFICATION_EMAIL=
